{
  "name": "teleton",
  "version": "0.11.4",
  "workspaces": [
    "packages/*"
  ],
  "description": "Personal AI Agent for Telegram",
  "author": "ZKProof (https://t.me/zkproof)",
  "license": "MIT",
  "keywords": [
    "telegram",
    "ai",
    "agent",
    "ton",
    "blockchain",
    "userbot",
    "llm"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/TONresistor/teleton-agent.git"
  },
  "bugs": {
    "url": "https://github.com/TONresistor/teleton-agent/issues"
  },
  "homepage": "https://github.com/TONresistor/teleton-agent#readme",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "teleton": "./bin/teleton.js"
  },
  "files": [
    "dist/",
    "bin/",
    "src/templates/"
  ],
  "scripts": {
    "build": "npm run build:sdk && npm run build:backend && npm run build:web",
    "build:sdk": "npm run build -w @teleton-agent/sdk",
    "check:sdk-package": "npm run build:sdk && node scripts/check-sdk-package.mjs",
    "build:backend": "tsup --config tsup.config.ts",
    "build:web": "cd web && npm run build",
    "prestart": "npm run build",
    "start": "node dist/cli/index.js start",
    "dev": "tsx watch src/index.ts",
    "dev:cli": "tsx src/cli/index.ts",
    "dev:web": "cd web && npm run dev",
    "setup": "node dist/cli/index.js setup",
    "doctor": "node dist/cli/index.js doctor",
    "lint": "eslint src packages/sdk/src --max-warnings 0",
    "lint:fix": "eslint src packages/sdk/src --fix",
    "format": "prettier --write \"src/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\"",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:sdk:coverage": "vitest run --config vitest.sdk.config.ts --coverage",
    "typecheck": "tsc --noEmit",
    "typecheck:test": "tsc --noEmit -p tsconfig.test.json",
    "knip": "knip",
    "circular": "madge --circular --no-spinner --no-color --extensions ts --ts-config tsconfig.json src/",
    "dupcheck": "jscpd --config .jscpd.json src/",
    "audit:ci": "audit-ci --config ./audit-ci.jsonc",
    "audit:web": "npm --prefix web audit --audit-level=high",
    "check:runtime": "node scripts/check-runtime-contract.mjs",
    "prepublishOnly": "npm run build",
    "prepare": "husky"
  },
  "dependencies": {
    "@dedust/sdk": "^0.8.7",
    "@earendil-works/pi-ai": "^1.2.0",
    "@hono/node-server": "^2.1.5",
    "@huggingface/transformers": "^4.3.1",
    "@inquirer/prompts": "^8.7.3",
    "@modelcontextprotocol/sdk": "^1.31.0",
    "@sinclair/typebox": "^0.34.52",
    "@tavily/core": "^0.7.14",
    "@ton/core": "^0.63.1",
    "@ton/crypto": "^3.3.0",
    "@ton/ton": "^16.3.0",
    "better-sqlite3": "^13.0.3",
    "chalk": "^6.0.1",
    "chokidar": "^5.0.0",
    "commander": "^15.0.0",
    "grammy": "^1.46.0",
    "hono": "^4.13.13",
    "hono-rate-limiter": "^0.5.4",
    "mediainfo.js": "^0.3.8",
    "ora": "^9.4.1",
    "pino": "^10.4.0",
    "pino-pretty": "^13.2.0",
    "qrcode-terminal": "^0.12.0",
    "selfsigned": "^5.5.0",
    "sqlite-vec": "^0.1.7",
    "telegram": "github:TONresistor/gramjs#5ad36509a9561cd26ab6acce9511dcdd6ce4c535",
    "yaml": "^2.9.1",
    "zod": "^4.6.7",
    "eventsource-parser": "^4.1.2"
  },
  "overrides": {
    "@aws-sdk/xml-builder": "3.972.19",
    "fast-xml-parser": "5.7.1",
    "axios": "1.20.0",
    "brace-expansion": "5.0.12",
    "esbuild": "0.28.1",
    "fast-uri": "3.1.8",
    "ip-address": "10.7.1",
    "nanoid": "3.3.18",
    "sharp": "0.35.5"
  },
  "devDependencies": {
    "@ston-fi/api": "^0.32.0",
    "@ston-fi/sdk": "^2.7.0",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^22.20.5",
    "@types/qrcode-terminal": "^0.12.2",
    "@typescript-eslint/eslint-plugin": "^8.71.2",
    "@typescript-eslint/parser": "^8.71.2",
    "@vitest/coverage-v8": "^5.0.4",
    "audit-ci": "^7.1.0",
    "eslint": "^10.12.0",
    "husky": "^9.1.7",
    "jscpd": "^5.4.1",
    "knip": "^6.41.0",
    "lint-staged": "^16.4.0",
    "madge": "^8.0.0",
    "prettier": "^3.9.10",
    "tsup": "^8.5.1",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^5.0.4",
    "@teleton-agent/sdk": "^2.1.0"
  },
  "engines": {
    "node": "^22.22.2 || ^24.15.0 || >=26.0.0"
  },
  "lint-staged": {
    "src/**/*.ts": [
      "eslint --fix",
      "prettier --write"
    ],
    "packages/sdk/src/**/*.ts": [
      "eslint --fix",
      "prettier --write"
    ]
  }
}
